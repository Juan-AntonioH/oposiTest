{
  "expo": {
    "name": "Opositest",
    "slug": "opositest",
    "version": "1.0.23",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo.webp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app_logo.webp"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/app_logo.webp"
    },
    "plugins": [
      "expo-router"
    ]
  }
}